{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with customizable information and role.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "bio": { "type": "string", "description": "Customizable bio" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin"] },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "number", "description": "timestamp" },
        "updatedAt": { "type": "number", "description": "timestamp" }
      },
      "required": ["role", "createdAt"]
    },
    "Report": {
      "title": "Threat Report",
      "description": "Information about a specific cyber threat submitted by a user.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["Malware", "Phishing", "Scams", "Vulnerabilities"] },
        "subcategory": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "isStarred": { "type": "boolean", "description": "Whether it's flagged as a 'star' known threat" },
        "allowComments": { "type": "boolean" },
        "upvoteCount": { "type": "number" },
        "downvoteCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "aiModerationStatus": { "type": "string", "enum": ["pending", "clean", "flagged"] }
      },
      "required": ["category", "title", "content", "authorId", "status", "allowComments", "createdAt", "upvoteCount", "downvoteCount"]
    },
    "Vote": {
      "title": "Vote",
      "description": "Upvote or downvote for a report.",
      "type": "object",
      "properties": {
        "value": { "type": "number", "enum": [1, -1] }
      },
      "required": ["value"]
    },
    "Comment": {
      "title": "Report Comment",
      "description": "A comment on a specific report.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "Flag": {
      "title": "Content Flag",
      "description": "Flag for moderation.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "targetPath": { "type": "string" },
        "reporterId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "number" }
      },
      "required": ["targetId", "targetPath", "reporterId", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Threat reports submitted by users"
    },
    "/reports/{reportId}/votes/{userId}": {
      "schema": { "$ref": "#/entities/Vote" },
      "description": "Votes for a specific report, organized by user IDs to ensure a single vote per user"
    },
    "/reports/{reportId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments on reports"
    },
    "/flags/{flagId}": {
      "schema": { "$ref": "#/entities/Flag" },
      "description": "Flags on content for moderation queue"
    }
  }
}
